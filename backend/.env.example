# LLM provider: claude_cli | local | mock
CC_LLM_PROVIDER=claude_cli

# claude_cli provider
CC_CLAUDE_MODEL=opus          # opus for impact analysis, sonnet for extraction
CC_CLAUDE_TIMEOUT=600     # batched tagging of a 100-clause contract takes minutes

# local provider (the on-prem / no-leakage target)
CC_LOCAL_BASE_URL=http://localhost:11434
CC_LOCAL_MODEL=qwen2.5:32b-instruct

# scraper: set to 1 to replay from data/fixtures instead of hitting the network
CC_OFFLINE=0

# scheduler
CC_SCRAPE_CRON_HOUR=7
CC_TIMEZONE=Asia/Singapore
CC_SCHEDULER_ENABLED=1

# scraper
CC_SCRAPE_LOOKBACK_DAYS=7
