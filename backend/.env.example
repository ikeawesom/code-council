# LLM provider: claude_cli | local | mock
LEX_LLM_PROVIDER=claude_cli

# claude_cli provider
LEX_CLAUDE_MODEL=opus          # opus for impact analysis, sonnet for extraction
LEX_CLAUDE_TIMEOUT=120

# local provider (the on-prem / no-leakage target)
LEX_LOCAL_BASE_URL=http://localhost:11434
LEX_LOCAL_MODEL=qwen2.5:32b-instruct

# scraper: set to 1 to replay from data/fixtures instead of hitting the network
LEX_OFFLINE=0

# scheduler
LEX_SCRAPE_CRON_HOUR=7
LEX_TIMEZONE=Asia/Singapore
